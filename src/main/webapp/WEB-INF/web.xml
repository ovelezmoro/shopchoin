<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                              https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>Servlet 3+ / JSP Starter</display-name>

    <!-- No <servlet> / <servlet-mapping> here on purpose: HelloServlet is
         registered via @WebServlet instead. This file is kept only for the
         handful of things annotations can't do (welcome files, session config,
         error pages, filters if you add them later, etc.) -->

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

</web-app>
